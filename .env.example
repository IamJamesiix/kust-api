NODE_ENV=development
PORT=3000
DATABASE_URL="postgres://user:password@host:5432/db"
JWT_ACCESS_SECRET=at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Email: gmail | resend | log (log = print codes in the terminal; local dev)
EMAIL_PROVIDER=log
EMAIL_FROM="Kust <kust.budget.app@gmail.com>"
# Gmail API (EMAIL_PROVIDER=gmail). Values come from the kust-mailer Google Cloud project.
GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Resend (EMAIL_PROVIDER=resend), once Kust has its own domain
RESEND_API_KEY=
# Google sign-in: web client id first, comma separated
GOOGLE_CLIENT_IDS=

// Money is stored in KOBO as BigInt (₦1,500.50 = 150050). Never floats.
// Percentages are basis points: 5000 = 50%, 1250 = 12.5%.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum IncomeType {
  STUDENT
  SALARIED
  FREELANCE
}

// "What's your main goal right now?" (onboarding)
enum Goal {
  STOP_RUNNING_OUT
  SAVE_FOR_SOMETHING
  BUILD_CUSHION
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  // Null for people who only ever signed in with Google.
  passwordHash  String?
  // Google's permanent id for this person ("sub" in the ID token).
  googleId      String?        @unique
  role          Role           @default(USER)
  incomeType    IncomeType     @default(SALARIED)
  budgets       Budget[]
  expenses      Expense[]
  formulas      Formula[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  bucketPlaces  BucketPlace[]

  // Onboarding answers (the "name + 4 questions" pages)
  onboardedAt    DateTime? // null = still has to do onboarding
  moneySource    String? // allowance | salary | clients | business | mixed
  nextMoneyAt    DateTime? // when the next money is expected: powers "₦X a day until..."
  unavoidablePct Int? // 20..90: % of money that goes to things they can't avoid
  goal           Goal?

  // Settings (Profile page)
  remindersOn   Boolean @default(true)
  handwritingOn Boolean @default(true) // words write themselves in
  shareAmounts  Boolean @default(false) // may share cards show naira amounts?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// What a person calls each kind of bucket and where its money lives
// ("Needs" lives in "My main bank"). One row per colorKey (needs, wants, savings, invest).
model BucketPlace {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  colorKey  String
  baseLabel String? // the formula's name for it ("Needs"), so a rename only applies to that bucket
  label     String? // their name for it ("Bills")
  livesIn   String? // "My main bank", "My savings app"
  updatedAt DateTime @updatedAt

  @@unique([userId, colorKey])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One-time codes sent by email. Only the hash is stored.
model OtpCode {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, purpose])
}

model Formula {
  id          String          @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean         @default(false)
  ownerId     String?
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buckets     FormulaBucket[]
  budgets     Budget[]
  createdAt   DateTime        @default(now())

  @@index([ownerId])
}

model FormulaBucket {
  id        String  @id @default(uuid())
  formulaId String
  formula   Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  label     String
  percent   Int
  colorKey  String
  position  Int

  @@index([formulaId])
}

model Budget {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  formulaId      String
  formula        Formula      @relation(fields: [formulaId], references: [id])
  incomeKobo     BigInt
  periodStart    DateTime     @default(now())
  source         String? // where the money came from: allowance | salary | client | sales | gift | other | balance
  idempotencyKey String?
  allocations    Allocation[]
  expenses       Expense[]
  createdAt      DateTime     @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model Allocation {
  id         String @id @default(uuid())
  budgetId   String
  budget     Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  label      String
  colorKey   String
  percent    Int
  amountKobo BigInt
  position   Int
  livesIn    String? // copied from BucketPlace when the budget is made
  movedAt    DateTime? // ticked on the "Move the money" checklist
  expenses   Expense[]

  @@index([budgetId])
}

// Money the user actually spent, logged against one bucket of one budget.
model Expense {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId     String
  budget       Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  amountKobo   BigInt
  note         String?
  category     String? // food | transport | data | eating_out | other
  spentAt      DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([budgetId])
  @@index([allocationId])
  @@index([userId, spentAt])
}

// Money is stored in KOBO as BigInt (₦1,500.50 = 150050). Never floats.
// Percentages are basis points: 5000 = 50%, 1250 = 12.5%.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum IncomeType {
  STUDENT
  SALARIED
  FREELANCE
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  passwordHash  String
  role          Role           @default(USER)
  incomeType    IncomeType     @default(SALARIED)
  budgets       Budget[]
  expenses      Expense[]
  formulas      Formula[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One-time codes sent by email. Only the hash is stored.
model OtpCode {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, purpose])
}

model Formula {
  id          String          @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean         @default(false)
  ownerId     String?
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buckets     FormulaBucket[]
  budgets     Budget[]
  createdAt   DateTime        @default(now())

  @@index([ownerId])
}

model FormulaBucket {
  id        String  @id @default(uuid())
  formulaId String
  formula   Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  label     String
  percent   Int
  colorKey  String
  position  Int

  @@index([formulaId])
}

model Budget {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  formulaId      String
  formula        Formula      @relation(fields: [formulaId], references: [id])
  incomeKobo     BigInt
  periodStart    DateTime     @default(now())
  idempotencyKey String?
  allocations    Allocation[]
  expenses       Expense[]
  createdAt      DateTime     @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model Allocation {
  id         String @id @default(uuid())
  budgetId   String
  budget     Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  label      String
  colorKey   String
  percent    Int
  amountKobo BigInt
  position   Int
  expenses   Expense[]

  @@index([budgetId])
}

// Money the user actually spent, logged against one bucket of one budget.
model Expense {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId     String
  budget       Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  amountKobo   BigInt
  note         String?
  spentAt      DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([budgetId])
  @@index([allocationId])
  @@index([userId, spentAt])
}
